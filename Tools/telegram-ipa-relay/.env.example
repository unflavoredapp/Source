# Copy to .env and fill in. Never commit .env.

RELAY_TOKEN=change-me-long-random
PUBLIC_BASE_URL=https://ipa.yourdomain.com
PORT=8787
TTL_HOURS=24
MAX_BYTES=4294967296

# From my.telegram.org → API development tools (same as AirShare)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# From: npm run login   (or paste an existing session string)
TELEGRAM_SESSION=

# Private drop channel — either numeric id OR invite link (one is enough)
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_INVITE=https://t.me/+yourInviteHash
# Bot that is admin in the channel — forwards the post to the recipient
TELEGRAM_BOT_TOKEN=
